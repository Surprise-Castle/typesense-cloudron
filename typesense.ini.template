[server]
api-address = 0.0.0.0
api-port = 8108
data-dir = ${TYPESENSE_DATA_DIR}
log-dir = /run/typesense
api-key = ${TYPESENSE_API_KEY}
enable-cors = ${TYPESENSE_ENABLE_CORS}
log-level = ${TYPESENSE_LOG_LEVEL}

# Performance settings
num-memory-shards = 4
snapshot-interval-seconds = 3600
healthy-read-lag = 1000
healthy-write-lag = 1000

# Cache — default is 1000, raising to 10k improves hit ratio
# (current 42% → expected 70%+ with 2M product catalog)
cache-num-entries = 10000


# Threading — use 4 of 8 vCPUs for search, leaving headroom
# for imports, raft consensus, and OS overhead.
thread-pool-size = 4